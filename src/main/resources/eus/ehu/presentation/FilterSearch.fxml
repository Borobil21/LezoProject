<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="820.0" prefWidth="1000.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.ui.SearchController">
   <children>

      <!-- NAVBAR -->
      <AnchorPane prefHeight="70.0" prefWidth="1000.0" style="-fx-background-color: #007bff;">
         <children>
            <Label layoutX="40.0" layoutY="20.0" text="%app.title" textFill="WHITE">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Button fx:id="profileName" layoutX="855.0" layoutY="17.0" mnemonicParsing="false" onAction="#handleViewProfile" prefHeight="36.0" prefWidth="130.0" style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #cfe3ff; -fx-border-radius: 18; -fx-text-fill: #005fcc; -fx-font-weight: bold; -fx-cursor: hand;" text="%button.my_profile">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button layoutX="700.0" layoutY="17.0" mnemonicParsing="false" onAction="#handleCreatePost" prefHeight="36.0" prefWidth="130.0" style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #cfe3ff; -fx-border-radius: 18; -fx-text-fill: #005fcc; -fx-font-weight: bold; -fx-cursor: hand;" text="%button.create_post" />
         </children>
      </AnchorPane>

      <!-- LEFT PANEL — Filters -->
      <AnchorPane layoutX="40.0" layoutY="90.0" prefHeight="700.0" prefWidth="300.0" style="-fx-background-color: #ffffff; -fx-border-color: #dddddd;">
         <children>

            <Label layoutX="20.0" layoutY="15.0" text="%label.refine_search">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <Label fx:id="clearAllLabel" layoutX="220.0" layoutY="18.0" onMouseClicked="#handleClearAll" style="-fx-cursor: hand;" text="%label.clear_all" textFill="#007bff" />

            <Label layoutX="20.0" layoutY="50.0" text="%label.brand_manufacturers">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <CheckBox fx:id="porscheCheck" layoutX="20.0" layoutY="75.0" text="Porsche" />
            <CheckBox fx:id="bmwCheck" layoutX="20.0" layoutY="95.0" text="BMW" />
            <CheckBox fx:id="audiCheck" layoutX="20.0" layoutY="115.0" text="Audi" />
            <CheckBox fx:id="mercedesCheck" layoutX="20.0" layoutY="135.0" text="Mercedes-Benz" />
            <CheckBox fx:id="teslaCheck" layoutX="20.0" layoutY="155.0" text="Tesla" />
            <Label fx:id="showMoreBrandsLabel" layoutX="20.0" layoutY="178.0" onMouseClicked="#handleShowMoreBrands" style="-fx-cursor: hand;" text="+ Show all brands" textFill="#007bff" />

            <!-- Price Range — two sliders -->
            <Label layoutX="20.0" layoutY="208.0" text="Price Range">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Slider fx:id="minPriceSlider" layoutX="20.0" layoutY="230.0" prefWidth="260.0" min="0" max="200000" value="0" showTickLabels="false" />
            <Slider fx:id="maxPriceSlider" layoutX="20.0" layoutY="252.0" prefWidth="260.0" min="0" max="200000" value="200000" showTickLabels="false" />
            <TextField fx:id="minPriceField" layoutX="20.0" layoutY="276.0" prefHeight="28.0" prefWidth="120.0" promptText="€ 0" style="-fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4;" />
            <TextField fx:id="maxPriceField" layoutX="160.0" layoutY="276.0" prefHeight="28.0" prefWidth="120.0" promptText="€ 200.000" style="-fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4;" />

            <!-- Kilometers — two sliders -->
            <Label layoutX="20.0" layoutY="318.0" text="Kilometers">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Slider fx:id="minKmSlider" layoutX="20.0" layoutY="340.0" prefWidth="260.0" min="0" max="500000" value="0" showTickLabels="false" />
            <Slider fx:id="maxKmSlider" layoutX="20.0" layoutY="362.0" prefWidth="260.0" min="0" max="500000" value="500000" showTickLabels="false" />
            <TextField fx:id="minKmField" layoutX="20.0" layoutY="386.0" prefHeight="28.0" prefWidth="120.0" promptText="0 Km" style="-fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4;" />
            <TextField fx:id="maxKmField" layoutX="160.0" layoutY="386.0" prefHeight="28.0" prefWidth="120.0" promptText="500.000 Km" style="-fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4;" />

            <!-- Vehicle Age -->
            <Label layoutX="20.0" layoutY="428.0" text="Vehicle Age">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <CheckBox fx:id="newCheck" layoutX="20.0" layoutY="452.0" text="New (2025-2026)" />
            <CheckBox fx:id="almostNewCheck" layoutX="20.0" layoutY="472.0" text="Almost New (2021-24)" />
            <CheckBox fx:id="usedCheck" layoutX="20.0" layoutY="492.0" text="Used (2006-2020)" />
            <CheckBox fx:id="oldCheck" layoutX="20.0" layoutY="512.0" text="Old (Pre-2006)" />

            <!-- Motor & Fuel -->
            <ComboBox fx:id="motorTypeComboBox" layoutX="20.0" layoutY="548.0" prefHeight="28.0" prefWidth="260.0" promptText="Motor &amp; Fuel" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" />

            <!-- Apply button -->
            <Button layoutX="20.0" layoutY="600.0" mnemonicParsing="false" onAction="#handleSearch" prefHeight="40.0" prefWidth="260.0" style="-fx-background-color: #007bff; -fx-background-radius: 6;" text="Apply Filters" textFill="WHITE">
               <font><Font name="System Bold" size="14.0" /></font>
            </Button>

         </children>
      </AnchorPane>

      <!-- RIGHT PANEL — Results -->
      <AnchorPane layoutX="360.0" layoutY="90.0" prefHeight="700.0" prefWidth="600.0" style="-fx-background-color: #ffffff; -fx-border-color: #dddddd;">
         <children>
            <Label fx:id="placeholderLabel" layoutX="140.0" layoutY="280.0" text="%placeholder.search_results" textFill="#aaaaaa">
               <font><Font size="14.0" /></font>
            </Label>
            <ListView fx:id="resultsListView" layoutX="10.0" layoutY="10.0" prefHeight="580.0" prefWidth="580.0" visible="false" style="-fx-background-color: transparent; -fx-control-inner-background: transparent;" />
         </children>
      </AnchorPane>

   </children>
</AnchorPane>
