<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1000.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.ui.LoginController">
   <children>
      
      <AnchorPane prefHeight="70.0" prefWidth="1000.0" style="-fx-background-color: #007bff;">
         <children>
            <Label layoutX="40.0" layoutY="20.0" text="PickAuto" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <AnchorPane layoutX="150.0" layoutY="110.0" prefHeight="630.0" prefWidth="700.0" style="-fx-background-color: #ffffff; -fx-border-color: #dddddd;">
         <children>
            <Label layoutX="285.0" layoutY="153.0" text="Hello there">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <Label layoutX="221.0" layoutY="226.0" text="Email">
               <font>
                  <Font size="15.0" />
               </font></Label>
            <TextField fx:id="txtEmail" layoutX="207.0" layoutY="251.0" prefHeight="35.0" prefWidth="290.0" promptText="Please enter your email here." style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" />

            <Label layoutX="220.0" layoutY="352.0" text="Password">
               <font>
                  <Font size="15.0" />
               </font></Label>
            <PasswordField fx:id="txtPassword" layoutX="207.0" layoutY="381.0" prefHeight="35.0" prefWidth="290.0" promptText="Please enter your password here." />

            <Button layoutX="252.0" layoutY="475.0" mnemonicParsing="false" onAction="#handleLogin" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #007bff;" text="Enter" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Label fx:id="lblError" alignment="CENTER" contentDisplay="CENTER" disable="true" ellipsisString="" layoutX="103.0" layoutY="542.0" prefHeight="59.0" prefWidth="498.0" text="Something went wrong, please check everything is filled" textAlignment="CENTER" textOverrun="CLIP" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
