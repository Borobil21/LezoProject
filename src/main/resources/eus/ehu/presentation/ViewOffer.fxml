<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="800.0" prefWidth="1000.0"
            style="-fx-background-color: #f0f2f5;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="eus.ehu.ui.ViewOfferController">
   <children>

      <!-- NAVBAR -->
      <AnchorPane prefHeight="64.0" prefWidth="1000.0"
                  style="-fx-background-color: #007bff;">
         <children>
            <Label layoutX="32.0" layoutY="16.0" text="%app.title" textFill="WHITE">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
                <Button layoutX="748.0" layoutY="14.0"
                    mnemonicParsing="false" onAction="#handleGoToSearch"
                    prefHeight="36.0" prefWidth="110.0"
                    style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #cfe3ff; -fx-border-radius: 18; -fx-text-fill: #005fcc; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="%button.go_back">
               <font><Font size="13.0" /></font>
            </Button>
                <Button layoutX="866.0" layoutY="14.0"
                    mnemonicParsing="false" onAction="#handleViewProfile"
                    prefHeight="36.0" prefWidth="110.0"
                    style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #cfe3ff; -fx-border-radius: 18; -fx-text-fill: #005fcc; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="%button.my_profile">
               <font><Font size="13.0" /></font>
            </Button>
         </children>
      </AnchorPane>

      <!-- TOP-LEFT: IMAGE CARD -->
      <AnchorPane layoutX="24.0" layoutY="80.0" prefHeight="340.0" prefWidth="468.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dde3ec; -fx-border-radius: 10; -fx-border-width: 1;">
         <children>
            <Label fx:id="Model" layoutX="15.0" layoutY="12.0" prefHeight="32.0" prefWidth="438.0" text="%viewoffer.brand_model" wrapText="true">
               <font><Font name="System Bold" size="18.0" /></font>
            </Label>
            <ImageView fx:id="carImage" accessibleText="%viewoffer.image_accessible_text" fitHeight="255.0" fitWidth="380.0" layoutX="44.0" layoutY="58.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../funnycar.jpg" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>

      <!-- TOP-RIGHT: VEHICLE DETAILS CARD -->
      <AnchorPane layoutX="508.0" layoutY="80.0" prefHeight="340.0" prefWidth="468.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dde3ec; -fx-border-radius: 10; -fx-border-width: 1;">
         <children>
            <Label layoutX="20.0" layoutY="15.0" text="%viewoffer.vehicle_details" textFill="#007bff">
               <font><Font name="System Bold" size="14.0" /></font>
            </Label>
         <Rectangle layoutX="20.0" layoutY="35.0" width="428.0" height="1.0" fill="#e8edf3" />
            
            <!-- Age Row -->
            <Label layoutX="20.0" layoutY="50.0" text="%viewoffer.age" textFill="#888888" prefWidth="200.0" />
            <Label fx:id="Age" layoutX="270.0" layoutY="50.0" alignment="CENTER_RIGHT" prefWidth="178.0" />
            <Rectangle layoutX="20.0" layoutY="70.0" width="428.0" height="1.0" fill="#f2f4f7" />
            
            <!-- Mileage Row -->
            <Label layoutX="20.0" layoutY="85.0" text="%viewoffer.mileage" textFill="#888888" prefWidth="200.0" />
            <Label fx:id="Mileage" layoutX="270.0" layoutY="85.0" alignment="CENTER_RIGHT" prefWidth="178.0" />
            <Rectangle layoutX="20.0" layoutY="105.0" width="428.0" height="1.0" fill="#f2f4f7" />
            
            <!-- Motor Type Row -->
            <Label layoutX="20.0" layoutY="120.0" text="%viewoffer.motor_type" textFill="#888888" prefWidth="200.0" />
            <Label fx:id="MotorType" layoutX="270.0" layoutY="120.0" alignment="CENTER_RIGHT" prefWidth="178.0" />
            <Rectangle layoutX="20.0" layoutY="140.0" width="428.0" height="1.0" fill="#f2f4f7" />
            
            <!-- Horse Power Row -->
            <Label layoutX="20.0" layoutY="155.0" text="%viewoffer.horse_power" textFill="#888888" prefWidth="200.0" />
            <Label fx:id="HorsePower" layoutX="270.0" layoutY="155.0" alignment="CENTER_RIGHT" prefWidth="178.0" />
            <Rectangle layoutX="20.0" layoutY="175.0" width="428.0" height="1.0" fill="#f2f4f7" />
            
            <!-- Price Row -->
            <Label layoutX="20.0" layoutY="190.0" text="%viewoffer.price" textFill="#888888" prefWidth="200.0" />
            <Label fx:id="Price" layoutX="20.0" layoutY="210.0" prefHeight="44.0" prefWidth="428.0" textFill="#007bff">
               <font><Font name="System Bold" size="20.0" /></font>
            </Label>
            <Rectangle layoutX="20.0" layoutY="260.0" width="428.0" height="1.0" fill="#e8edf3" />
            <Label layoutX="20.0" layoutY="275.0" text="%viewoffer.verified_listing" textFill="#2eaa6e">
               <font><Font size="11.0" /></font>
            </Label>
         </children>
      </AnchorPane>

      <!-- BOTTOM-LEFT: DESCRIPTION CARD -->
      <AnchorPane layoutX="24.0" layoutY="436.0" prefHeight="340.0" prefWidth="468.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dde3ec; -fx-border-radius: 10; -fx-border-width: 1;">
         <children>
            <Label layoutX="15.0" layoutY="12.0" text="%viewoffer.description_label" textFill="#007bff">
               <font><Font name="System Bold" size="14.0" /></font>
            </Label>
            <Rectangle layoutX="15.0" layoutY="32.0" width="438.0" height="1.0" fill="#e8edf3" />
            <Label fx:id="AdditionalDescription" alignment="TOP_LEFT" layoutX="15.0" layoutY="50.0" prefHeight="275.0" prefWidth="438.0" text="-" wrapText="true" />
         </children>
      </AnchorPane>

      <!-- BOTTOM-RIGHT: ACTIONS CARD -->
      <AnchorPane layoutX="508.0" layoutY="436.0" prefHeight="340.0" prefWidth="468.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dde3ec; -fx-border-radius: 10; -fx-border-width: 1;">
         <children>
            <Button fx:id="WishlistButton" layoutX="15.0" layoutY="15.0" mnemonicParsing="false" onAction="#handleAddToWishlist" prefHeight="50.0" prefWidth="438.0" style="-fx-background-color: #007bff; -fx-border-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;" text="%viewoffer.add_wishlist">
               <font><Font name="System Bold" size="13.0" /></font>
            </Button>
            <Rectangle layoutX="15.0" layoutY="75.0" width="438.0" height="1.0" fill="#e8edf3" />
            <Button fx:id="BuyButton" layoutX="15.0" layoutY="95.0" mnemonicParsing="false" prefHeight="50.0" prefWidth="210.0" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="%viewoffer.buy_now">
               <font><Font name="System Bold" size="12.0" /></font>
            </Button>
            <Button fx:id="OfferButton" layoutX="243.0" layoutY="95.0" mnemonicParsing="false" prefHeight="50.0" prefWidth="210.0" style="-fx-background-color: transparent; -fx-text-fill: #007bff; -fx-border-color: #007bff; -fx-border-width: 2; -fx-font-weight: bold; -fx-cursor: hand;" text="%viewoffer.make_offer">
               <font><Font name="System Bold" size="12.0" /></font>
            </Button>
         </children>
      </AnchorPane>

   </children>
</AnchorPane>