<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="800.0" prefWidth="1050.0"
            style="-fx-background-color: #f0f2f5;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="eus.ehu.ui.ViewOfferController">
   <children>

      <!-- NAVBAR -->
      <AnchorPane prefHeight="64.0" prefWidth="1050.0"
                  style="-fx-background-color: #007bff;">
         <children>
            <Label layoutX="32.0" layoutY="16.0" text="PickAuto" textFill="WHITE">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Button layoutX="790.0" layoutY="14.0"
                    mnemonicParsing="false" onAction="#handleGoToSearch"
                    prefHeight="36.0" prefWidth="110.0"
                    style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #cfe3ff; -fx-border-radius: 18; -fx-text-fill: #005fcc; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="Go back">
               <font><Font size="13.0" /></font>
            </Button>
            <Button layoutX="916.0" layoutY="14.0"
                    mnemonicParsing="false" onAction="#handleViewProfile"
                    prefHeight="36.0" prefWidth="110.0"
                    style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #cfe3ff; -fx-border-radius: 18; -fx-text-fill: #005fcc; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="My profile">
               <font><Font size="13.0" /></font>
            </Button>
         </children>
      </AnchorPane>

      <!-- LEFT CARD -->
      <AnchorPane layoutX="28.0" layoutY="80.0" prefHeight="696.0" prefWidth="590.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dde3ec; -fx-border-radius: 10; -fx-border-width: 1;">
         <children>
            <Label fx:id="Model" layoutX="24.0" layoutY="22.0"
                   prefHeight="38.0" prefWidth="400.0"
                   text="Loading...">
               <font><Font name="System Bold" size="22.0" /></font>
            </Label>
            <Button fx:id="WishlistButton" layoutX="390.0" layoutY="24.0"
                    mnemonicParsing="false" onAction="#handleAddToWishlist"
                    prefHeight="34.0" prefWidth="176.0"
                    text="❤  Add to Wishlist">
               <font><Font size="13.0" /></font>
            </Button>
            <Rectangle layoutX="24.0" layoutY="66.0" width="542.0" height="1.0" fill="#e8edf3" />

            <!-- CORREGIDO: Añadido fx:id="carImage" -->
            <ImageView fx:id="carImage"
                       fitHeight="270.0" fitWidth="542.0"
                       layoutX="24.0" layoutY="78.0"
                       pickOnBounds="true" preserveRatio="true" />

            <Rectangle layoutX="24.0" layoutY="362.0" width="542.0" height="1.0" fill="#e8edf3" />
            <Label layoutX="24.0" layoutY="374.0" text="Additional description" textFill="#888888">
               <font><Font name="System Bold" size="11.0" /></font>
            </Label>
            <Label fx:id="AdditionalDescription" alignment="TOP_LEFT"
                   layoutX="24.0" layoutY="396.0"
                   prefHeight="270.0" prefWidth="542.0"
                   wrapText="true" textFill="#444444">
               <font><Font size="13.0" /></font>
            </Label>
         </children>
      </AnchorPane>

      <!-- SPECS CARD -->
      <AnchorPane layoutX="634.0" layoutY="80.0" prefHeight="310.0" prefWidth="388.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dde3ec; -fx-border-radius: 10; -fx-border-width: 1;">
         <children>
            <Label layoutX="20.0" layoutY="18.0" text="Vehicle details" textFill="#007bff">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Rectangle layoutX="20.0" layoutY="40.0" width="348.0" height="1.0" fill="#e8edf3" />
            <Label layoutX="20.0" layoutY="54.0" text="Age" textFill="#888888" />
            <Label fx:id="Age" layoutX="260.0" layoutY="54.0" alignment="CENTER_RIGHT" />
            <Rectangle layoutX="20.0" layoutY="74.0" width="348.0" height="1.0" fill="#f2f4f7" />
            <Label layoutX="20.0" layoutY="86.0" text="Mileage" textFill="#888888" />
            <Label fx:id="Mileage" layoutX="260.0" layoutY="86.0" alignment="CENTER_RIGHT" />
            <Rectangle layoutX="20.0" layoutY="106.0" width="348.0" height="1.0" fill="#f2f4f7" />
            <Label layoutX="20.0" layoutY="118.0" text="Motor type" textFill="#888888" />
            <Label fx:id="MotorType" layoutX="260.0" layoutY="118.0" alignment="CENTER_RIGHT" />
            <Rectangle layoutX="20.0" layoutY="138.0" width="348.0" height="1.0" fill="#f2f4f7" />
            <Label layoutX="20.0" layoutY="150.0" text="Horse power" textFill="#888888" />
            <Label fx:id="HorsePower" layoutX="260.0" layoutY="150.0" alignment="CENTER_RIGHT" />
            <Rectangle layoutX="0.0" layoutY="178.0" width="388.0" height="1.0" fill="#e8edf3" />
            <Label layoutX="20.0" layoutY="192.0" text="Price" textFill="#888888" />
            <Label fx:id="Price" layoutX="20.0" layoutY="212.0" prefHeight="44.0" prefWidth="348.0" />
            <Label layoutX="20.0" layoutY="268.0" text="✔  Verified listing" textFill="#2eaa6e" />
         </children>
      </AnchorPane>

      <!-- ACTIONS CARD -->
      <AnchorPane layoutX="634.0" layoutY="406.0" prefHeight="160.0" prefWidth="388.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dde3ec; -fx-border-radius: 10; -fx-border-width: 1;">
         <children>
            <Button fx:id="BuyButton" layoutX="20.0" layoutY="20.0" prefHeight="50.0" prefWidth="348.0" text="BUY NOW" />
            <Button fx:id="OfferButton" layoutX="20.0" layoutY="86.0" prefHeight="50.0" prefWidth="348.0" text="MAKE AN OFFER" />
         </children>
      </AnchorPane>

   </children>
</AnchorPane>