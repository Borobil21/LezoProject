<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1000.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.ui.RegisterController">
   <children>
      
      <AnchorPane prefHeight="70.0" prefWidth="1000.0" style="-fx-background-color: #007bff;">
         <children>
            <Label layoutX="40.0" layoutY="20.0" text="PickAuto" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <AnchorPane layoutX="150.0" layoutY="110.0" prefHeight="630.0" prefWidth="700.0" style="-fx-background-color: #ffffff; -fx-border-color: #dddddd;">
         <children>
            <Label layoutX="137.0" layoutY="49.0" text="Please fill all your information to register">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <Label layoutX="40.0" layoutY="134.0" text="Name" />
            <TextField fx:id="txtName" layoutX="40.0" layoutY="159.0" prefHeight="35.0" prefWidth="290.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" />
            
            <Label layoutX="370.0" layoutY="134.0" text="Email" />
            <TextField fx:id="txtEmail" layoutX="370.0" layoutY="159.0" prefHeight="35.0" prefWidth="290.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" />

            <Label layoutX="207.0" layoutY="358.0" text="Password" />
            <TextField fx:id="txtPassword" layoutX="207.0" layoutY="383.0" prefHeight="35.0" prefWidth="290.0" promptText="Please remember your password" style="-fx-border-color: #cccccc;" />
            
            <Label layoutX="370.0" layoutY="254.0" text="Location" />
            <TextField fx:id="txtLocation" layoutX="370.0" layoutY="279.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />

            <Button layoutX="253.0" layoutY="447.0" mnemonicParsing="false" onAction="#handleRegister" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #007bff;" text="Register" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button layoutX="300.0" layoutY="503.0" mnemonicParsing="false" onAction="#handleGoToLogin" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-border-color: #007bff; -fx-text-fill: #007bff;" text="Login">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
            <Label layoutX="40.0" layoutY="254.0" text="Phone" />
            <TextField fx:id="txtPhone" layoutX="40.0" layoutY="279.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />
            <Label fx:id="InformationLabel" alignment="CENTER" contentDisplay="CENTER" disable="true" ellipsisString="" layoutX="103.0" layoutY="542.0" prefHeight="59.0" prefWidth="498.0" textAlignment="CENTER" textOverrun="CLIP" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
