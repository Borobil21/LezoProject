            <Label layoutX="40.0" layoutY="505.0" text="Sale price (€)">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <TextField layoutX="40.0" layoutY="530.0" prefHeight="40.0" prefWidth="200.0" promptText="0.00" style="-fx-border-color: #007bff; -fx-font-size: 16px;" />

            <Button layoutX="460.0" layoutY="530.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #007bff;" text="POST" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
