            <Label layoutX="40.0" layoutY="20.0" text="PickAuto" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label layoutX="850.0" layoutY="25.0" text="My profile" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <AnchorPane layoutX="150.0" layoutY="110.0" prefHeight="630.0" prefWidth="700.0" style="-fx-background-color: #ffffff; -fx-border-color: #dddddd;">
         <children>
            <Label layoutX="40.0" layoutY="30.0" text="Create a post">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <Label layoutX="40.0" layoutY="90.0" text="Brand" />
            <ComboBox layoutX="40.0" layoutY="115.0" prefHeight="35.0" prefWidth="290.0" promptText="Select the brand of the car" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" />
            
            <Label layoutX="370.0" layoutY="90.0" text="Model" />
            <TextField layoutX="370.0" layoutY="115.0" prefHeight="35.0" prefWidth="290.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" />

            <Label layoutX="40.0" layoutY="180.0" text="Age" />
            <TextField layoutX="40.0" layoutY="205.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />
            
            <Label layoutX="370.0" layoutY="180.0" text="Mileage (km)" />
            <TextField layoutX="370.0" layoutY="205.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />

            <Label layoutX="40.0" layoutY="270.0" text="Motor type" />
            <ComboBox layoutX="40.0" layoutY="295.0" prefHeight="35.0" prefWidth="290.0" promptText="Gasoline / Diesel / Electric" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" />
            
            <Label layoutX="370.0" layoutY="270.0" text="Horse Power (CV)" />
            <TextField layoutX="370.0" layoutY="295.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />

            <Label layoutX="40.0" layoutY="360.0" text="Additional description" />
