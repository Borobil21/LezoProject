<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1000.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.ui.CreateController">
   <children>
      
      <AnchorPane prefHeight="70.0" prefWidth="1000.0" style="-fx-background-color: #007bff;">
         <children>
            <Label layoutX="40.0" layoutY="20.0" text="PickAuto" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label layoutX="850.0" layoutY="25.0" text="My profile" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <AnchorPane layoutX="150.0" layoutY="110.0" prefHeight="630.0" prefWidth="700.0" style="-fx-background-color: #ffffff; -fx-border-color: #dddddd;">
         <children>
            <Label layoutX="40.0" layoutY="30.0" text="Create a post">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <Label layoutX="40.0" layoutY="90.0" text="Brand" />
            
            <Label layoutX="370.0" layoutY="90.0" text="Model" />

            <Label layoutX="40.0" layoutY="170.0" text="Age" />
            
            <Label layoutX="370.0" layoutY="170.0" text="Mileage (km)" />

            <Label layoutX="40.0" layoutY="246.0" text="Motor type" />
            
            <Label layoutX="370.0" layoutY="246.0" text="Horse Power (CV)" />

            <Label layoutX="40.0" layoutY="411.0" text="Additional description" />
            <Label layoutX="40.0" layoutY="322.0" text="License plate" />
            <Label layoutX="370.0" layoutY="322.0" text="Price">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <TextField fx:id="brand" layoutX="40.0" layoutY="115.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />
            <TextField fx:id="model" layoutX="370.0" layoutY="115.0" prefHeight="35.0" prefWidth="290.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" />
            <TextField fx:id="age" layoutX="40.0" layoutY="195.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />
            <TextField fx:id="mileage" layoutX="370.0" layoutY="195.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />
            <ComboBox fx:id="motorType" layoutX="40.0" layoutY="271.0" prefHeight="35.0" prefWidth="290.0" promptText="Gasoline / Diesel / Electric" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" />
            <TextField fx:id="horsePower" layoutX="370.0" layoutY="271.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />
            <TextField fx:id="licensePlate" layoutX="40.0" layoutY="346.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />
            <TextField fx:id="price" layoutX="370.0" layoutY="346.0" prefHeight="35.0" prefWidth="290.0" style="-fx-border-color: #cccccc;" />
            <TextArea fx:id="description" layoutX="40.0" layoutY="436.0" prefHeight="100.0" prefWidth="620.0" style="-fx-border-color: #cccccc;" />

            <Button fx:id="postButton" defaultButton="true" layoutX="460.0" layoutY="559.0" mnemonicParsing="false" onAction="#post" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #007bff;" text="POST" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
