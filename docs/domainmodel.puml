@startuml PickAuto_Domain_Model

enum Role {
    REGISTERED_USER
    ADMIN
}

enum Condition {
    NEW
    ALMOST_NEW
    USED
    CLASSIC
}

enum ListingStatus {
    ACTIVE
    SOLD
    EXPIRED
}

class User {
    - int id
    - String name
    - String email
    - String password
    - String phone
    - String location
    - Role role
    + register()
    + login()
}

class Vehicle {
    - String make
    - String model
    - int year
    - int mileage
    - int powerCV
    - String fuelType
    - String transmission
    - Condition condition
    - List<String> photoPaths
}

abstract class Listing {
    - int id
    - String description
    - String location
    - LocalDateTime createdAt
    - ListingStatus status
    + markAsSold()
}

class Sale {
    - double fixedPrice
}

class Auction {
    - double minBid
    - LocalDateTime endDate
    - double currentHighestBid
}

class Bid {
    - double amount
    - LocalDateTime timestamp
}

class Message {
    - String content
    - LocalDateTime sentAt
}

' Relaciones
User "1" *-- "0..*" Listing : creates
User "1" o-- "0..*" Listing : favorites
User "1" -- "0..*" Bid : places
User "1" -- "0..*" Message : sends/receives

Listing "1" *-- "1" Vehicle : describes
Listing <|-- Sale
Listing <|-- Auction
Listing "1" -- "0..*" Message : regarding

Auction "1" *-- "0..*" Bid : receives

@enduml