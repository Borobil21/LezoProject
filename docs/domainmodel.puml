@startuml PickAuto_Domain_Model

skinparam classAttributeIconSize 0
hide methods

enum Role {
    REGISTERED_USER
    ADMIN
}

enum Condition {
    NEW
    ALMOST_NEW
    USED
    CLASSIC
}

enum ListingStatus {
    ACTIVE
    SOLD
    EXPIRED
}

class User {
    - int id
    - String name
    - String email
    - String password
    - String phone
    - String location
}

class Vehicle {
    - String make
    - String model
    - int year
    - int mileage
    - int powerCV
    - String fuelType
    - String transmission
}

class Photo {
    - int id
    - byte[] content
    - String format
    - String description
    - LocalDateTime uploadedAt
}

abstract class Listing {
    - int id
    - String description
    - String location
    - LocalDateTime createdAt
}

class Sale {
    - double fixedPrice
}

class Auction {
    - double minBid
    - LocalDateTime endDate
    - double currentHighestBid
}

class Bid {
    - double amount
    - LocalDateTime timestamp
}

class Message {
    - String content
    - LocalDateTime sentAt
}

' Relaciones
User "1" *-- "0..*" Listing : creates
User "1" o-- "0..*" Listing : favorites
User "1" -- "0..*" Bid : places
User "1" -- "0..*" Message : sends/receives

Listing "1" *-- "1" Vehicle : describes
Listing <|-- Sale
Listing <|-- Auction
Listing "1" -- "0..*" Message : regarding

Auction "1" *-- "0..*" Bid : receives

Vehicle "1" *-- "1..*" Photo : has

User "1" -- "1" Role : has
Vehicle "1" -- "1" Condition : is in
Listing "1" -- "1" ListingStatus : is in.

@enduml