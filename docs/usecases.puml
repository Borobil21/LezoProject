@startuml


left to right direction

actor User as user
actor Member as member
actor Admin as admin

member --|> user

rectangle "PickAuto System" {

  package "Authentication" {
    (Register)
    (Log in)
  }

  package "Member Actions" {
    (View Profile)
    (View Offer)
    (Filter Search)
    (Report Post)
    (Like Post)
    (Create a post)
  }

  package "Admin Actions" {
    (Delete Post)
    (View Reports)
  }
}

' User connections
user --> (Register)
user --> (Log in)

' Member connections
member --> (View Profile)
member --> (View Offer)
member --> (Filter Search)
member --> (Report Post)
member --> (Like Post)
member --> (Create a post)

' Admin connections
admin --> (Delete Post)
admin --> (View Reports)

@enduml